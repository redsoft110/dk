gs/tongyong/#-exprimental","title":"\u5b9e\u9a8c\u6027-Exprimental","text":""},{"location":"settings/tongyong/#-window-manager","title":"\u7a97\u53e3\u7ba1\u7406-Window Manager","text":""},{"location":"settings/tongyong/#-nameplates","title":"\u540d\u5b57\u663e\u793a-Nameplates","text":""},{"location":"settings/tongyong/#-cooldowanw","title":"\u51b7\u5374\u65f6\u95f4-Cooldowanw","text":""},{"location":"skills/Anatomy/","title":"\u89e3\u7834\u5b66-Anatomy","text":""},{"location":"skills/Anatomy/#_1","title":"\u63cf\u8ff0","text":"<p>\u89e3\u5256\u6280\u80fd\u63d0\u5347\u6b66\u5668\u4f24\u5bb3\uff0c\u63d0\u5347\u6325\u51fb\u901f\u5ea6\uff0c\u5e76\u901a\u8fc7\u6cbb\u7597\u6280\u80fd\u589e\u52a0\u7ef7\u5e26\u6cbb\u7597\u7684\u6cbb\u7597\u91cf\u3002\u89e3\u5256\u5b66\u548c\u6cbb\u7597\u6280\u80fd\u8fbe\u523060\u7ea7\u6216\u4ee5\u4e0a\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5c1d\u8bd5\u7528\u7ef7\u5e26\u6cbb\u6108\u6bd2\u7d20\uff0c\u8fbe\u523080\u7ea7\u6216\u4ee5\u4e0a\u65f6\uff0c\u4e24\u8005\u90fd\u53ef\u4ee5\u5c1d\u8bd5\u590d\u6d3b\u6b7b\u53bb\u7684\u73a9\u5bb6\u3002\u540c\u65f6\u8fd8\u80fd\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u5bf9\u6d41\u8840\u6216\u75be\u75c5\u6548\u679c\u7684\u4f24\u5bb3\u6297\u6027\u3002 \u7597\u6108\u4e92\u52a8 \u5c1d\u8bd5\u7ef7\u5e26\u6cbb\u7597\u9700\u8981\u6700\u4f4e\u89e3\u5256\u6280\u80fd60 \u5c1d\u8bd5\u7ef7\u5e26\u590d\u6d3b\u9700\u8981\u6700\u4f4e\u89e3\u5256\u6280\u80fd80 \u62e5\u6709100\u6cbb\u7597\u548c\u81f3\u5c1180\u89e3\u5256\u5b66\u7684\u73a9\u5bb6\uff0c\u59cb\u7ec8\u6709100%\u7684\u51e0\u7387\u7528\u7ef7\u5e26\u590d\u6d3b\u76ee\u6807 \u7ef7\u5e26\u6cbb\u7597\u91cf\u4e3a\uff08\uff08\u6cbb\u7597\u6280\u80fd / 100\uff09 * \uff08\uff08\u968f\u673a\u503c40\u523060\uff09 * \uff081 + \uff080.2 * \u89e3\u5256\u6280\u80fd / 100\uff09\uff09\uff09</p> <p>\u6218\u6597\u5f71\u54cd \u8fdb\u653b\u52a0\u6210 \u6b66\u5668\u7c7b\u578b    \u6bcf\u6b21\u6325\u51fb\u4f24\u5bb3\u589e\u52a0 \u8fd1\u6218/\u5c04\u7bad   \u57fa\u7840\u6b66\u5668\u4f24\u5bb3 *\uff0820% * \uff08\u89e3\u5256\u6280\u80fd / 100\uff09\uff09 \u9605\u8bfb\u66f4\u591a\u5173\u4e8e\u57fa\u7840\u6b66\u5668\u4f24\u5bb3\u7684\u4fe1\u606f \u4e0a\u8ff0\u52a0\u6210\u662f\u6838\u5fc3\u4f24\u5bb3\u4fee\u6b63\uff0c\u4e0d\u53d7PvP\u4e2d20%SDi\u4e0a\u9650\u9650\u5236 \u62e5\u6709\u89e3\u5256\u5b66\u3001\u6b66\u5668\u5b66\u3001\u6cd5\u533b\u8bc4\u4f30\u3001\u8ffd\u8e2a\u548c/\u6216\u6454\u8de4\u7b49\u81f3\u5c11\u4e24\u9879\u6280\u80fd\u8d85\u8fc780\u7684\u9009\u624b\u53ef\u4ee5\u5c1d\u8bd5\u817f\u7b4b\u4f24 \u5c06\u73a9\u5bb6\u7684\u6b66\u5668\u7ec8\u7ed3\u6280\u51e0\u7387\u63d0\u5347\u4e3a\u666e\u901a\uff08\u4ec5PvM\uff09\u7684100% * \uff08\u89e3\u5256\u6280\u80fd / 100\uff09\uff09 \u63d0\u5347\u73a9\u5bb6\u7684\u6325\u780d\u901f\u5ea6\u52a0\u6210\uff085% * \uff08\u89e3\u5256\u6280\u80fd / 100\uff09\uff09\uff08\u4ec5\u9650PvM\uff09 \u9632\u5fa1\u52a0\u6210 \u63d0\u4f9b\u6d41\u8840\u548c\u75be\u75c5\u4f24\u5bb3\u7684\uff0825% * * \uff08\u89e3\u5256\u6280\u80fd / 100\uff09\uff09\u51cf\u5c11 \u63d0\u4f9b\uff0850% * \uff08\u89e3\u5256\u6280\u80fd / 100\uff09\uff09\u51e0\u7387\u65e0\u89c6\u751f\u7269\u9020\u6210\u7684\u7ef7\u5e26\u6ed1\u843d</p> <p>\u57f9\u8bad</p> <p>\u6280\u80fd  \u6d3b\u52a8 0-50    \u6765\u81eaNPC\u7684\u5217\u8f66 50-80   \u5728\u65b0\u73a9\u5bb6\u5730\u4e0b\u57ce\u901a\u8fc7\u6cbb\u7597\u6216\u8fd1\u6218\u88ab\u52a8\u8fdb\u884c 80-100  \u88ab\u52a8\u6cbb\u7597\u6216\u8fd1\u6218</p>"},{"location":"skills/Archery/","title":"\u5c04\u7bad-Archery","text":"<p>\u63cf\u8ff0 \u5c04\u7bad\u6280\u80fd\u51b3\u5b9a\u73a9\u5bb6\u5728\u4f7f\u7528\u5c04\u7bad\u6280\u80fd\u6b66\u5668\u65f6\u653b\u51fb\u6216\u8eb2\u907f\u653b\u51fb\u7684\u6982\u7387\u3002\u5f13\u7bad\u6b66\u5668\u7684\u4f24\u5bb3\u901a\u5e38\u4f4e\u4e8e\u5e73\u5747\u6c34\u5e73\uff0c\u4f46\u80fd\u901a\u8fc7\u5c04\u7a0b\u5e26\u6765\u7684\u5b89\u5168\u6027\u5f25\u8865\u8fd9\u4e00\u70b9\u3002\u5c04\u7bad\u6b66\u5668\u9700\u8981\u7bad\u77e2\u6216\u7bad\u77e2\u7b49\u5f39\u836f\u624d\u80fd\u53d1\u5c04\u3002\u5f13\u7bad\u6b66\u5668\u5bf9\u751f\u7269\u7684\u7279\u6b8a\u653b\u51fb\u662f\u963b\u788d\uff0c\u80fd\u6682\u65f6\u4f7f\u76ee\u6807\u5931\u53bb\u884c\u52a8\u80fd\u529b\u3002</p> <p>\u6458\u8981 \u5f13\u7bad\u6280\u80fd\u5141\u8bb8\u73a9\u5bb6\u7528\u5f13\u548c\u5f29\u8fdc\u8ddd\u79bb\u5c04\u7bad/\u5f29\u7bad</p> <p>\u5f13\u7bad\u7c7b\u6b66\u5668\u4e0d\u80fd\u4e2d\u6bd2\u3002 \u73a9\u5bb6\u5fc5\u987b\u4fdd\u6301\u9759\u6b620.5\u79d2\u624d\u80fd\u5c04\u51fb\uff08\u65e0\u8bba\u654f\u6377\u5982\u4f55\uff09 \u9759\u6b62\u5ef6\u8fdf\u5728PvP\u4e2d\u6839\u636e\u73a9\u5bb6\u654f\u6377\u8c03\u6574\uff0c\u4ece1.0\u79d2\uff08\u654f\u637725\u6216\u66f4\u4f4e\uff09\u52300.5\u79d2\uff08\u654f\u6377100\u6216\u66f4\u9ad8\uff09\u4e0d\u7b49 \u5f13\u7bad\u53ef\u4ee5\u5c04\u51fb\u8ddd\u79bb\u5f13\u7bad\u624b\u6700\u591a10\u683c\u7684\u76ee\u6807 \u5f29\u548c\u5927\u5f13\u53ef\u4ee5\u5c04\u51fb\u8ddd\u79bb\u5f13\u7bad\u624b\u6700\u591a8\u683c\u7684\u76ee\u6807 \u5c04\u7bad\u7c7b\u6b66\u5668\u547d\u4e2d\u6982\u7387\u7b49\u4e8e\uff08\u653b\u51fb\u65b9\u5f13\u7bad\u6280\u80fd+50\uff09/\uff08\u9632\u5fa1\u8005\u6b66\u5668\u6216\u6454\u8de4\u6280\u80fd+50\uff09\u00d72\u52a0\u4e0a\u4efb\u4f55\u76f8\u5173\u7684\u547d\u4e2d\u7387\u52a0\u6210 \u4f5c\u4e3a\u526f\u6b66\u5668\u6280\u80fd\uff08\u4f7f\u7528\u5176\u4ed6\u6b66\u5668\u6280\u80fd\u65f6\uff09\u5728PvM\u4e2d\u63d0\u5347\u57fa\u7840\u6b66\u5668\u4f24\u5bb3\uff0825% \u00d7 \u6280\u80fd / 100\uff09\u3002 \u4f5c\u4e3a\u526f\u6b66\u5668\u6280\u80fd\uff08\u4f7f\u7528\u5176\u4ed6\u6b66\u5668\u6280\u80fd\u65f6\uff09\u5728PvP\u4e2d\u63d0\u5347\u57fa\u7840\u6b66\u5668\u4f24\u5bb3\uff0810% * \u6280\u80fd / 100\uff09\u3002\uff08PvP\u8fd1\u6218\u8865\u5145\u4f24\u5bb3\u4e0a\u965020%\uff09 \u5f13\u7bad\u6b66\u5668\u5728\u8bb8\u591a\u8ba1\u7b97\u4e2d\u88ab\u89c6\u4e3a\u201c\u8fd1\u6218\u201d\u6b66\u5668\uff0c\u6bd4\u5982\u638c\u63e1\u94fe\u52a0\u6210</p> <p>PvM\u7279\u6b8a\u653b\u51fb \u53ea\u5bf9\u751f\u7269\u6709\u6548\uff0c\u5bf9\u5176\u4ed6\u73a9\u5bb6\u65e0\u6548 \u73a9\u5bb6\u670910%\u7684\u51e0\u7387\u5bf9\u751f\u7269\u65bd\u52a0\u5f13\u7bad\u6b66\u5668\u7279\u6b8a\u653b\u51fb \u8fd9\u4e2a\u51e0\u7387\u8fd8\u53ef\u4ee5\u901a\u8fc7\u6b66\u5668\u77e5\u8bc6\u6280\u80fd\u3001 \u6c34\u5c5e\u6027\u62a4\u7532\u6216\u7cbe\u901a\u94fe\u73af\u8fdb\u4e00\u6b65\u63d0\u5347 \u5c06\u89e6\u53d1\u7279\u6b8a\u653b\u51fb\u7684\u4f24\u5bb3\u63d0\u534750%\uff08\u5982\u679c\u76ee\u6807\u5df2\u7ecf\u88ab\u963b\u788d\u6216\u514d\u75ab\u963b\u788d\uff0c\u5219\u63d0\u5347100%\uff09 \u4f24\u5bb3\u63d0\u5347100%\uff0c\u5e76\u963b\u788d\u76ee\u6807\uff08\u963b\u6b62\u6240\u6709\u79fb\u52a8\u3001\u65bd\u6cd5\u548c\u8fd1\u6218\u653b\u51fb\uff09\uff0c\u6301\u7eed4-8\u79d2\u3002\u5982\u679c\u76ee\u6807\u5bf9\u963b\u788d\u514d\u75ab\uff0c\u4f24\u5bb3\u4f1a\u63d0\u534750% \u963b\u788d\u6548\u679c\u6301\u7eed\u65f6\u95f4\u4f1a\u6839\u636e\u6b66\u5668\u901f\u5ea6\uff08\u8f83\u6162\u7684\u5f13\u7bad\u6b66\u5668\u6548\u679c\u6301\u7eed\u65f6\u95f4\u66f4\u957f\uff09\u548c\u751f\u7269\u96be\u5ea6\u800c\u8c03\u6574 \u73a9\u5bb6\u5728\u4f7f\u7528\u5f13\u7bad\u6b66\u5668\u5bf9\u4ed8\u53d7\u963b\u751f\u7269\u65f6\u8fd8\u4f1a\u83b7\u5f97+25%\u7684\u547d\u4e2d\u7387\u52a0\u6210 \u4e00\u65e6\u751f\u7269\u4ece\u73a9\u5bb6\u6b66\u5668\u9020\u6210\u7684\u963b\u788d\u6548\u679c\u4e2d\u6062\u590d\uff0c\u5b83\u5c06\u83b7\u5f97\u6301\u7eed\u65f6\u95f4\u7b49\u4e8e\u539f\u59cb\u963b\u788d\u6301\u7eed50%\u7684\u514d\u75ab \u8fd9\u79cd\u514d\u75ab\u4f1a\u5e26\u6765\u4e0e\u901a\u5e38\u5bf9\u514d\u75ab\u5e72\u6270\u76ee\u6807\u65bd\u52a0\u963b\u788d\u8005\u76f8\u540c\u7684\u4f24\u5bb3\u52a0\u6210 \u4f8b\u5982\uff0c\u73a9\u5bb6\u4f7f\u7528\u5f13\u7bad\u5bf9\u751f\u7269\u65bd\u653e6\u79d2\u7684\u963b\u788d\u6548\u679c\u30026\u79d2\u963b\u788d\u7ed3\u675f\u540e\uff0c\u751f\u7269\u5728\u63a5\u4e0b\u6765\u76843\u79d2\u5185\u514d\u75ab\u963b\u788d\uff0c\u5728\u6b64\u671f\u95f4\u4efb\u4f55\u65b0\u7684\u963b\u788d\u6548\u679c\u5c1d\u8bd5\u90fd\u4f1a\u83b7\u5f97\u4f24\u5bb3\u52a0\u6210 PvP \u56fa\u5b9a\u6548\u679c\u4e0e\u8981\u6c42 \u9759\u6b62\u5ef6\u8fdf\u662f\u6307\u73a9\u5bb6\u5fc5\u987b\u5728\u540c\u4e00\u683c\u5b50\u4e0a\u505c\u7559\u4e00\u6bb5\u65f6\u95f4\uff0c\u624d\u80fd\u8ba9\u8fdc\u7a0b\u6b66\u5668\u5f00\u706b PvP\u4e2d\u7684\u6b66\u5668\u6325\u51fb\u5ef6\u8fdf</p> <p>\u5f13\u7bad\u548c\u5965\u672f\u6b66\u5668\u7684\u9759\u6b62\u5ef6\u8fdf\u5728PvP\u4e2d\u6839\u636e\u73a9\u5bb6\u7684\u654f\u6377\u8c03\u6574\uff0c\u5ef6\u8fdf\u4ece1.0\u79d2\uff08\u654f\u637725\u6216\u66f4\u4f4e\uff09\u52300.5\u79d2\uff08\u654f\u6377100\u6216\u66f4\u9ad8\uff09\u4e0d\u7b49[\u4e4b\u524d\u56fa\u5b9a\u4e3a0.5\u79d2] \u793a\u4f8b \u654f\u6377\u4e3a25\u7684\u73a9\u5bb6\u5fc5\u987b\u9759\u6b621.0\u79d2\u540e\u624d\u80fd\u53d1\u5c04\u5f13\u7bad/\u5965\u672f\u6b66\u5668 \u654f\u6377\u4e3a63\u7684\u73a9\u5bb6\u5fc5\u987b\u9759\u6b620.75\u79d2\u540e\u624d\u80fd\u53d1\u5c04\u5f13\u7bad/\u5965\u672f\u6b66\u5668 \u654f\u6377\u4e3a100\u7684\u73a9\u5bb6\u5fc5\u987b\u9759\u6b620.5\u79d2\u540e\u624d\u80fd\u53d1\u5c04\u5f13\u7bad/\u5965\u672f\u6b66\u5668</p> <p>PvP\u4e2d\u7684\u4f24\u5bb3\u5ef6\u8fdf</p> <p>\u5728PvP\u4e2d\u7528\u8fdc\u7a0b\u6b66\u5668\u653b\u51fb\u65f6\uff0c\u547d\u4e2d\u4f24\u5bb3\u4f1a\u6709\u968f\u673a\u7684\u5ef6\u8fdf\uff0c\u6839\u636e\u654f\u6377\u968f\u673a\u8c03\u6574\uff0c\u6700\u5927\u5ef6\u8fdf\u4ece0\u79d2\uff08100\u654f\u6377\u6216\u66f4\u9ad8\uff09\u52300.5\u79d2\uff08\u654f\u637725\u6216\u66f4\u4f4e\uff09\u4e0d\u7b49 \u793a\u4f8b \u654f\u6377\u4e3a25\u7684\u73a9\u5bb6\u8fdc\u7a0b\u6b66\u5668\u4f24\u5bb3\u4f1a\u67090\u52300.5\u79d2\u7684\u968f\u673a\u5ef6\u8fdf \u654f\u6377\u4e3a63\u7684\u73a9\u5bb6\u8fdc\u7a0b\u6b66\u5668\u4f24\u5bb3\u4f1a\u67090\u52300.25\u79d2\u7684\u968f\u673a\u5ef6\u8fdf \u654f\u6377100\u7684\u73a9\u5bb6\u8fdc\u7a0b\u6b66\u5668\u4f24\u5bb3\u6ca1\u6709\u5ef6\u8fdf</p>"}]}